{
  "app": {
    "auto_translate": true,
    "min_text_length": 1,
    "auto_start": false,
    "show_copy_button": true,
    "clipboard_fallback_enabled": true
  },
  "hotkeys": {
    "toggle_capture": "Ctrl+Shift+H",
    "manual_translate": "Ctrl+Q"
  },
  "api": {
    "timeout_seconds": 30,
    "endpoints": [
      {
        "name": "OpenAI",
        "base_url": "https://api.openai.com/v1",
        "api_key": "sk-your-api-key-here",
        "model": "gpt-4o-mini",
        "max_tokens": 1000,
        "enabled": true,
        "priority": 1
      },
      {
        "name": "DeepSeek",
        "base_url": "https://api.deepseek.com/v1",
        "api_key": "sk-your-api-key-here",
        "model": "deepseek-chat",
        "max_tokens": 1000,
        "enabled": false,
        "priority": 2
      }
    ]
  },
  "proxy": {
    "enabled": false,
    "host": "127.0.0.1",
    "port": 7890
  },
  "ui": {
    "opacity": 0.95,
    "font_size": 14
  },
  "prompts": {
    "translate": "你是专业的翻译助手。将以下文本翻译成中文，只返回翻译结果，不要解释：\n\n{text}",
    "explain": "请用简洁的语言解释以下内容的含义：\n\n{text}"
  }
}
